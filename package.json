{
  "name": "fatcat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "avatar:lab": "vite --config vite.avatar.config.ts",
    "build": "tsc -b && vite build",
    "build:avatar": "vite build --config vite.avatar.config.ts",
    "electron:dev": "npm --prefix electron run dev",
    "electron:test": "npm --prefix electron test",
    "electron:build": "npm --prefix electron run build",
    "electron:typecheck": "npm --prefix electron run typecheck",
    "electron:smoke": "npm --prefix electron test -- src/main/agent/shared-session-smoke.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@bible-strong/avatar-core": "^0.1.0",
    "@bible-strong/avatar-react": "^0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
